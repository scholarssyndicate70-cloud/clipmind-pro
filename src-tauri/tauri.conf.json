{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipMind Pro",
  "version": "1.0.0",
  "identifier": "io.clipmind.pro",

  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cd ../frontend && npm run dev",
    "beforeBuildCommand": "cd ../frontend && npm run build"
  },

  "app": {
    "windows": [
      {
        "title": "ClipMind Pro",
        "width": 1400,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:"
    }
  },

  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "VideoGraphics",
    "shortDescription": "AI-powered gaming clip editor",
    "longDescription": "ClipMind Pro automatically edits your gaming clips with AI-driven color grades, speed ramps, captions, and music — running entirely on your local hardware.",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": null
    },
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {}
    }
  },

  "plugins": {
    "dialog": {}
  }
}
